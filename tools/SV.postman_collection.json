    {
      "name": "759gaming GAMELIST",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// --- 1. Получаем данные из переменных окружения ---\r",
              "const accessKeyId = pm.environment.get(\"accessKeyId\");         // AccessKeyId\r",
              "const accessKeySecret = pm.environment.get(\"accessKeySecret\"); // AccessKeySecret\r",
              "let nonce = pm.environment.get(\"nonce\");                        // Nonce\r",
              "\r",
              "// Если nonce пустой, генерируем случайный\r",
              "if (!nonce) {\r",
              "    nonce = Math.random().toString(36).substring(2, 42);\r",
              "    pm.environment.set(\"nonce\", nonce);\r",
              "}\r",
              "\r",
              "// --- 2. Timestamp UTC+3 ---\r",
              "const now = new Date();\r",
              "const utcTime = now.getTime() + (now.getTimezoneOffset() * 60000); // UTC\r",
              "const utcPlus3 = new Date(utcTime + (3 * 60 * 60 * 1000));          // Минск UTC+3\r",
              "const timestamp = Math.floor(utcPlus3.getTime() / 1000).toString(); // в секундах\r",
              "pm.environment.set(\"timestamp\", timestamp);\r",
              "\r",
              "// --- 3. Формируем строку для подписи ---\r",
              "const signString = accessKeySecret + nonce + timestamp;\r",
              "\r",
              "// --- 4. Вычисляем SHA1 ---\r",
              "const signature = CryptoJS.SHA1(signString).toString();\r",
              "pm.environment.set(\"signature\", signature);\r",
              "\r",
              "// --- 5. Устанавливаем заголовки запроса ---\r",
              "pm.request.headers.add({ key: \"AccessKeyId\", value: accessKeyId });\r",
              "pm.request.headers.add({ key: \"Nonce\", value: nonce });\r",
              "pm.request.headers.add({ key: \"Timestamp\", value: timestamp });\r",
              "pm.request.headers.add({ key: \"Sign\", value: signature });\r",
              "\r",
              "// --- 6. Лог для проверки ---\r",
              "console.log(\"Nonce:\", nonce);\r",
              "console.log(\"Timestamp (UTC+3):\", timestamp);\r",
              "console.log(\"Sign string:\", signString);\r",
