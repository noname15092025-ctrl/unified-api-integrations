    {
      "name": "start/game /launch FOR Eurovirtuals Platform",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              ""
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 1. Укажите здесь ваш секретный ключ Eurovirtuals\r\nconst secretKey = \"94d96746c57691404063a2882849621bfd6ab8e27001ca1f43d407db0d60cefa\"; \r\n\r\n// 2. Получаем текущее время в секундах (Unix epoch seconds)\r\nconst timestamp = Math.floor(Date.now() / 1000).toString();\r\n\r\n// 3. Берем \"сырое\" тело запроса ровно в том виде, в котором оно на вкладке Body\r\nconst rawBody = pm.request.body.raw;\r\n\r\n// 4. Формируем строку для подписи: <timestamp>.<body>\r\nconst stringToSign = `${timestamp}.${rawBody}`;\r\n\r\n// 5. Считаем HMAC-SHA256 и переводим в hex (нижний регистр)\r\nconst signature = CryptoJS.HmacSHA256(stringToSign, secretKey).toString(CryptoJS.enc.Hex);\r\n\r\n// 6. Сохраняем значения в переменные окружения Postman, чтобы подставить их в Headers\r\npm.environment.set(\"x_timestamp\", timestamp);\r\npm.environment.set(\"x_signature\", signature);\r\n\r\nconsole.log(\"Сгенерирован timestamp:\", timestamp);\r\nconsole.log(\"Сгенерирована подпись:\", signature);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "x-timestamp",
            "value": "{{x_timestamp}}"
          },
          {
            "key": "x-signature",
            "value": "{{x_signature}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"betLimits\": {\r\n        \"maxStake\": 20000,\r\n        \"maxWin\": 20000000,\r\n        \"minStake\": 0.1\r\n    },\r\n    \"country\": \"KE\",\r\n    \"currency\": \"USD\",\r\n    \"device\": \"DESKTOP\",\r\n    \"exchangeRateUSD\": 1,\r\n    \"gameCode\": \"b103fcaf-5efd-46fc-a271-7cb25db3e9bb\",\r\n    \"language\": \"EN\",\r\n    \"lobbyUrl\": \"https://next-gen-ui.betkraft.co.uk\",\r\n    \"mode\": \"REAL\",\r\n    \"operatorId\": \"c3f88f6a-397e-4228-867b-f1684a2c3e1f\",\r\n    \"playerId\": \"aaaaaaaaaaano\",\r\n    \"projectId\": \"6\",\r\n    \"sessionId\": \"TOKEN\"\r\n}",
